{
  "name": "oss-browser",
  "version": "3.0.0",
  "main": "dist-electron/main/index.js",
  "description": "OSS客户端",
  "author": "linzb93",
  "license": "MIT",
  "private": true,
  "debug": {
    "env": {
      "VITE_DEV_SERVER_URL": "http://127.0.0.1:3344/"
    }
  },
  "type": "module",
  "config": {
    "electron_mirror": "http://npmmirror.com/mirrors/electron/",
    "electron_builder_binaries_mirror": "http://npmmirror.com/mirrors/electron-builder-binaries/"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/electron-builder.mjs",
    "build:only": "vite build",
    "build:app": "node scripts/electron-builder.mjs",
    "build:report": "cross-env MODE=report vite build",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/ali-oss": "^6.23.3",
    "@vitejs/plugin-vue": "^6.0.7",
    "cross-env": "^10.1.0",
    "electron": "^42.1.0",
    "electron-builder": "^26.15.3",
    "element-plus": "^2.14.5",
    "husky": "^9.0.11",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "rcedit": "^5.0.1",
    "rollup-plugin-visualizer": "^6.0.11",
    "sass": "^1.74.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-cdn-import": "^1.0.1",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vue": "^3.5.35",
    "vue-tsc": "^3.3.3"
  },
  "dependencies": {
    "@linzb93/utils": "^0.0.14",
    "@types/bytes": "^3.1.4",
    "ali-oss": "^6.20.0",
    "axios": "^1.7.9",
    "bytes": "^3.1.2",
    "dayjs": "1.11.13",
    "electron-is-dev": "^3.0.1",
    "electron-unhandled": "^4.0.1",
    "es-toolkit": "^1.52.0",
    "execa": "^9.3.1",
    "fs-extra": "8.1.0",
    "lowdb": "^7.0.1",
    "p-map": "^7.0.2",
    "rxjs": "^7.8.1",
    "slash": "^5.1.0",
    "standard-version": "^9.5.0",
    "uuid": "^11.0.5"
