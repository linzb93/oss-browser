{
  "name": "oss-browser",
  "version": "3.0.0",
  "main": "dist-electron/main/index.js",
  "description": "OSS客户端",
  "author": "linzb93",
  "license": "MIT",
  "private": true,
  "type": "module",
  "config": {
    "electron_mirror": "https://npmmirror.com/mirrors/electron/",
    "electron_builder_binaries_mirror": "https://npmmirror.com/mirrors/electron-builder-binaries/"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:debug": "electron-vite dev --watch --inspect=5858 --remoteDebuggingPort=9229",
    "build": "electron-vite build",
    "build:report": "electron-vite build --mode report",
    "build:app": "electron-builder --config electron-builder.config.ts --publish never",
    "build:win": "npm run build && electron-builder --config electron-builder.config.ts --win --publish never",
    "build:mac": "npm run build && electron-builder --config electron-builder.config.ts --mac --publish never",
    "preview": "electron-vite preview",
    "check": "npm run vue-tsc && npm run lint:fix",
    "tsc": "tsc --noEmit",
    "vue-tsc": "vue-tsc --noEmit",
    "lint": "npm run lint:dpdm && npm run lint:dpdm-fe && npm run lint:code",
    "lint:code": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:dpdm": "dpdm -T --tsconfig ./tsconfig.json --no-tree --no-warning --exit-code circular:1 src/main/bootstrap/index.ts",
    "lint:dpdm-fe": "dpdm -T --tsconfig ./tsconfig.json --no-tree --no-warning --exit-code circular:1 src/renderer/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "release": "standard-version",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@element-plus/icons-vue": "^2.3.2",
    "@eslint/js": "^9.39.1",
    "@stylistic/eslint-plugin": "^5.6.1",
    "@types/ali-oss": "^6.23.3",
    "@types/bytes": "^3.1.4",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.0.0",
    "@types/tmp": "^0.2.6",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.6",
    "dotenv": "^16.0.1",
    "dpdm": "^3.13.1",
    "electron": "^42.1.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "element-plus": "^2.14.5",
    "eslint": "^9.39.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-vue": "^10.6.2",
    "globals": "^16.5.0",
    "husky": "^9.0.11",
    "jsdom": "^28.1.0",
    "rcedit": "^5.0.1",
    "rollup-plugin-visualizer": "^6.0.11",
    "sass": "^1.74.1",
    "standard-version": "^9.5.0",
    "typescript": "^6.0.3",
    "vite": "^7.2.6",
    "vitest": "^4.0.16",
    "vue": "^3.5.35",
    "vue-tsc": "^3.3.3"
  },
  "dependencies": {
    "@linzb93/utils": "^0.0.14",
    "ali-oss": "^6.20.0",
    "axios": "^1.7.9",
    "bytes": "^3.1.2",
    "dayjs": "1.11.13",
    "electron-is-dev": "^3.0.1",
    "electron-unhandled": "^4.0.1",
    "es-toolkit": "^1.52.0",
    "execa": "^9.3.1",
    "fs-extra": "8.1.0",
    "lowdb": "^7.0.1",
    "p-map": "^7.0.2",
    "rxjs": "^7.8.1",
    "slash": "^5.1.0",
    "tmp": "^0.2.7",
    "uuid": "^11.0.5"
  }
}
